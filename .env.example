# Base de données
POSTGRES_USER=dataguard
POSTGRES_PASSWORD=change-me-in-local
POSTGRES_DB=dataguard
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API
DATAGUARD_ENV=local
DATAGUARD_LOG_LEVEL=INFO
DATAGUARD_CORS_ORIGINS=http://localhost:5173
DATAGUARD_MAX_DOWNLOAD_BYTES=52428800
DATAGUARD_RAW_DIR=/app/data/raw

# Observabilité : console en local, OTLP si un collecteur tourne
DATAGUARD_OTEL_EXPORTER=console
OTEL_SERVICE_NAME=dataguard-api

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
